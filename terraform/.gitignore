# generated by terraform init -- not committed
.terraform/

# the module-level lock file is generated when running terraform init
# directly inside modules/ during development. only the root lock file
# is committed since Terraform resolves providers from the root.
modules/**/.terraform.lock.hcl

# sensitive variable files -- never commit real credentials
*.tfvars.local
terraform.tfvars

# local state files -- we use the S3 backend
terraform.tfstate
terraform.tfstate.backup
